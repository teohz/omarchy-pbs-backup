{
  "pbs": {
    "repository": "backup@pbs!backup@pbs-host.example.com:datastore",
    "fingerprint": "aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa:aa",
    "change_detection_mode": "metadata"
  },
  "namespace": "teohz/core",
  "groups": [
    {
      "name": "external-drive",
      "display_name": "External drive",
      "source": "/mnt/external-drive",
      "schedule": "Sun *-*-* 03:00:00",
      "randomized_delay": "10m",
      "backup_id": null,
      "excludes": [
        "*/.cache/"
      ],
      "retention": { "daily": 7, "weekly": 4, "monthly": 12, "yearly": 3 },
      "prune_after_backup": true
    }
  ]
}
